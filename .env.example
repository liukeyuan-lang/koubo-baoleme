# AI / ASR（仅服务端读取；不要写入 app.js、index.html 或前端请求）
LLM_API_KEY=
LLM_MODEL=
MAX_LLM_CALLS_PER_GENERATION=5
# 回归测试默认使用 mock；只有显式设为 live 才允许消耗付费 token。
LLM_MODE=mock
DASHSCOPE_API_KEY=
ASR_MODEL=qwen3-asr-flash-filetrans

# Supabase 登录。Publishable Key 可安全下发到浏览器；Service Role Key 不要放前端。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 用户口述默认走本地 FunASR（Paraformer + VAD + 标点），首次运行自动下载模型。
LOCAL_ASR_ENABLED=true
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_TIMEOUT_SECONDS=1800
LOCAL_ASR_PUNC_MODEL=ct-punc-c
# 本地识别失败时如需回退到已配置的云端录音识别，再设为 true。
LOCAL_ASR_FALLBACK_CLOUD=false

# 内容解析 Provider。可以为每个平台单独配置，也可使用 CONTENT_PROVIDER_* 作为兜底。
DOUYIN_PROVIDER_URL=
DOUYIN_PROVIDER_TOKEN=
XIAOHONGSHU_PROVIDER_URL=
XIAOHONGSHU_PROVIDER_TOKEN=
KUAISHOU_PROVIDER_URL=
KUAISHOU_PROVIDER_TOKEN=
CONTENT_PROVIDER_URL=
CONTENT_PROVIDER_TOKEN=

# 安全边界
PROVIDER_TIMEOUT_MS=15000
SOURCE_PARSE_RATE_LIMIT=10
SOURCE_MEDIA_MAX_MB=80
SOURCE_VIDEO_MAX_SECONDS=600
MEDIA_TIMEOUT_MS=60000
# 生产环境建议填写 Provider 实际返回的 CDN 域名，逗号分隔。
MEDIA_HOST_ALLOWLIST=
